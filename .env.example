# Copy to .env (git-ignored) and adjust. All settings use the PRA_ prefix.

# standalone = local adapters (dev login, disk storage, RQ, DB audit). studio = AI Studio adapters (stubs).
PRA_PLATFORM_MODE=standalone
PRA_ENVIRONMENT=dev

PRA_DATABASE_URL=postgresql+psycopg://pra:pra@localhost:5432/pra
PRA_TEST_DATABASE_URL=postgresql+psycopg://pra:pra@localhost:5432/pra_test
PRA_REDIS_URL=redis://localhost:6379/0

# Sign-in tokens (standalone only). Use a long random value.
PRA_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
PRA_JWT_ISSUER=pra-standalone
PRA_JWT_TTL_MINUTES=480

# Password for the demo users (python -m app.cli seed-demo-users). At least 8 characters.
PRA_DEMO_PASSWORD=

# Fernet key for secrets at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PRA_FERNET_KEY=

# AI: none | anthropic
PRA_AI_PROVIDER=none
PRA_ANTHROPIC_API_KEY=
PRA_ANTHROPIC_MODEL=claude-opus-5-5
PRA_AI_MAX_RETRIES=2

# Files
PRA_STORAGE_DIR=./var/storage
PRA_UPLOAD_MAX_BYTES=10485760
PRA_UPLOAD_MAX_SHEETS=20
PRA_UPLOAD_MAX_ROWS=100000
PRA_UPLOAD_MAX_COLUMNS=500
PRA_UPLOAD_MAX_UNPACKED_BYTES=209715200
PRA_UPLOAD_MAX_PARTS=2000

# Comma-separated
PRA_CORS_ORIGINS=http://localhost:5173
